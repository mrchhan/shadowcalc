# ---------------------------------------------------------------------------
# ShadowCalc configuration. Copy to `.env` and fill in what you need.
# The app works with NO configuration: it uses the free, key-less
# ExchangeRate-API open endpoint, falling back to Frankfurter (ECB).
# ---------------------------------------------------------------------------

# --- Server-side only (never exposed to the browser) ------------------------
# Optional ExchangeRate-API key (https://www.exchangerate-api.com).
# When set, `npm start` / `npm run dev:server` serve /api/rates using it.
EXCHANGE_RATE_API_KEY=

# Port for the Node server (default 8787).
PORT=8787

# --- Client-side (baked into the build; must NOT contain secrets) -----------
# Point the app at the server proxy. Set to /api/rates when you run the
# bundled server; leave empty for static hosting such as GitHub Pages.
VITE_RATES_PROXY_URL=
